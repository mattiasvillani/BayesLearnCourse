\series bold
\color blue
LLN for a function 
\begin_inset Formula $f\left(x\right)$
\end_inset


\series default
\color inherit

\begin_inset Formula 
\begin{align*}
\bar{f_{n}} & =\frac{1}{n}\sum_{i=1}^{n}f\left(X_{i}\right)\overset{p}{\rightarrow}\mathbb{E}_{p}\left(f\left(X\right)\right)
\end{align*}

\end_inset

where 
\begin_inset Formula $X_{1},\ldots,X_{n}$
\end_inset

 are iid from 
\begin_inset Formula $p(x)$
\end_inset

.
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Itemize

\series bold
\color blue
CLT for a function 
\begin_inset Formula $f\left(x\right)$
\end_inset


\series default
\color inherit

\begin_inset Formula 
\[
\bar{f_{n}}\overset{\mathrm{approx}}{\sim}N\left(\mu_{f},\frac{\sigma_{f}^{2}}{n}\right),
\]

\end_inset

where 
\begin_inset Formula $\mu_{f}=\mathbb{E}_{p}\left(f\left(X\right)\right)$
\end_inset

 and 
\begin_inset Formula $\sigma_{f}^{2}=\mathbb{V}_{p}\left(f\left(X\right)\right)$
\end_inset

.
\begin_inset VSpace bigskip
\end_inset


\end_layout

\begin_layout Itemize
We can estimate 
\begin_inset Formula $\sigma_{f}^{2}$
\end_inset

 by sample variance of function evaluations
\begin_inset Formula 
\[
\hat{\sigma}_{f}^{2}=\frac{1}{n-1}\sum_{i=1}^{n}\left(f(x_{i})-\bar{f_{n}}\right)^{2}
\]

\end_inset


\end_layout

\end_deeper
