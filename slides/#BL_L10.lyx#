\begin_deeper
\begin_layout Itemize
Taylor approximation of the log posterior around the posterior mode 
\begin_inset Formula $\tilde{\theta}$
\end_inset

 gives:
\begin_inset Formula 
\begin{align*}
p(\mathbf{y}|\theta)p(\theta) & \approx p(\mathbf{y}|\tilde{\theta})p(\hat{\theta})\exp\left[-\frac{1}{2}J_{\mathbf{y}}(\tilde{\theta})(\theta-\tilde{\theta})^{2}\right]\\
 & =p(\mathbf{y}|\tilde{\theta})p(\tilde{\theta})(2\pi)^{p/2}\left\vert J_{\mathbf{y}}^{-1}(\tilde{\theta})\right\vert ^{1/2}\\
 & \times\underset{\text{multivariate normal density}}{\underbrace{(2\pi)^{-p/2}\left\vert J_{\mathbf{y}}^{-1}(\tilde{\theta})\right\vert ^{-1/2}\exp\left[-\frac{1}{2}J_{\mathbf{y}}(\tilde{\theta})(\theta-\tilde{\theta})^{2}\right]}}
\end{align*}

\end_inset


\end_layout

\begin_layout Itemize
So integrating both sides with respect to 
\begin_inset Formula $\theta$
\end_inset

 gives
\begin_inset Formula 
\[
p(\mathbf{y})=\int p(\mathbf{y}|\theta)p(\theta)d\theta=p(\mathbf{y}|\tilde{\theta})p(\tilde{\theta})(2\pi)^{p/2}\left\vert J_{\mathbf{y}}^{-1}(\tilde{\theta})\right\vert ^{1/2}
\]

\end_inset


\end_layout

\end_deeper
